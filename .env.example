# ──────────────────────────────────────────────────────────────────────────────
# Hey DJ — Configuration
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will never be committed.
# ──────────────────────────────────────────────────────────────────────────────


# ── Music library ─────────────────────────────────────────────────────────────
# Absolute path to your music folder. Supports MP3, FLAC, OGG, WAV, M4A, AAC.
# Can be a local path, NAS mount, or SSHFS mount.
MUSIC_DIR=/path/to/your/music


# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000


# ── Ollama (LLM for DJ commentary) ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# Recommended models (run `ollama pull <model>` before starting):
#   llama3.2:3b   — Best quality, ~2 GB RAM, 5–10 s on CPU, 1–2 s with GPU  ← default
#   llama3.2:1b   — Good quality, ~1.3 GB RAM, 2–4 s on CPU  ← use on low-RAM machines
#   qwen2.5:1.5b  — Good quality, ~1 GB RAM, 2–3 s on CPU
#   qwen2.5:0.5b  — Acceptable quality, ~400 MB RAM, ~1 s on CPU  ← absolute minimum
OLLAMA_MODEL=llama3.2:3b


# ── TTS — Kokoro ONNX ─────────────────────────────────────────────────────────
# Model files (~120 MB) are downloaded from Hugging Face on first run.
# They are cached in backend/ and never re-downloaded.

# Voice options:
#   af_heart    — Warm American female (default)
#   af_bella    — Bright American female
#   af_sky      — Airy American female
#   am_michael  — Deep American male
#   am_adam     — Neutral American male
KOKORO_VOICE=af_heart

# Speed multiplier: 0.8 = slower/clearer, 1.0 = natural, 1.2 = slightly faster
KOKORO_SPEED=1.0


# ── DJ Engine ─────────────────────────────────────────────────────────────────
# Crossfade duration between tracks in milliseconds (0 = no crossfade)
CROSSFADE_MS=4000

# Starting mood when the server boots (changeable at runtime via Settings):
#   chill | hype | focus | party | latenight | morning
DEFAULT_MOOD=chill

# Starting DJ persona (changeable at runtime via Settings):
#   smooth | hype | latenight
DEFAULT_PERSONA=smooth


# ── Data ──────────────────────────────────────────────────────────────────────
# Where to store the SQLite database (track library, queue, stats).
DATA_DIR=./data


# ── CORS ──────────────────────────────────────────────────────────────────────
# For local-only use, leave as *.
# For a public/remote deployment, set to your exact domain, e.g.:
#   CORS_ORIGINS=https://dj.yourdomain.com
CORS_ORIGINS=*


# ── Admin token (optional) ────────────────────────────────────────────────────
# When set, settings-mutation endpoints (e.g. POST /api/llm/settings) require
# an X-Admin-Token header matching this value. Leave empty for local-only use
# where any client on the host is trusted. Strongly recommended if the server
# is exposed to other machines.
ADMIN_TOKEN=
